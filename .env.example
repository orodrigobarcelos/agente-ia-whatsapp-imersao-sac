# ───────────── Servidor ─────────────
PORT=3000
NODE_ENV=production
LOG_LEVEL=info

# ───────────── Postgres ─────────────
# URL de conexão com o Postgres.
# Na Railway, vem auto-resolvida via referência: ${{Postgres.DATABASE_URL}}
DATABASE_URL=

# ───────────── Evolution API ─────────────
# URL interna da Evolution na Railway: http://<nome-do-servico>.railway.internal:8080
# (ou URL pública: https://<seu-evolution>.up.railway.app)
EVOLUTION_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=agente

# ───────────── OpenAI ─────────────
# Obrigatório: gpt-4.1-mini (chat), whisper-1 (áudio), gpt-4o-mini (imagem).
# Pode também ser sobrescrito em agent_configs.openai_api_key.
OPENAI_API_KEY=

# ───────────── URL pública do agente ─────────────
# A própria Railway expõe via RAILWAY_PUBLIC_DOMAIN; usado pra registrar o webhook
# do Evolution no boot. Não precisa setar manualmente.
PUBLIC_URL=

# ───────────── Tunings ─────────────
AGENT_BUFFER_SWEEPER_MS=20000
