{
  "$schema": "https://railway.com/template.schema.json",
  "metadata": {
    "name": "Agente IA WhatsApp (Simplificado)",
    "description": "Template plug-and-play de agente conversacional pra WhatsApp via Evolution API + OpenAI + Postgres. Customização via Claude Code + MCP Postgres.",
    "tags": ["whatsapp", "ai-agent", "openai", "evolution-api", "claude-code"]
  },
  "services": [
    {
      "name": "Postgres",
      "icon": "postgres",
      "source": { "image": "ghcr.io/railwayapp-templates/postgres-ssl:17" },
      "variables": {
        "POSTGRES_DB": "railway",
        "POSTGRES_USER": "postgres",
        "POSTGRES_PASSWORD": { "default": "$RANDOM_SECRET" },
        "PGDATA": "/var/lib/postgresql/data/pgdata",
        "DATABASE_URL": "postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${RAILWAY_PRIVATE_DOMAIN}:5432/${POSTGRES_DB}",
        "DATABASE_PUBLIC_URL": "postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${RAILWAY_TCP_PROXY_DOMAIN}:${RAILWAY_TCP_PROXY_PORT}/${POSTGRES_DB}"
      },
      "volumes": [
        { "mountPath": "/var/lib/postgresql/data", "name": "pgdata" }
      ]
    },
    {
      "name": "Evolution",
      "icon": "evolution-api",
      "source": { "image": "evoapicloud/evolution-api:v2.3.7" },
      "variables": {
        "SERVER_URL": "https://${{RAILWAY_PUBLIC_DOMAIN}}",
        "AUTHENTICATION_API_KEY": { "default": "$RANDOM_SECRET" },
        "AUTHENTICATION_EXPOSE_IN_FETCH_INSTANCES": "true",
        "DEL_INSTANCE": "false",
        "DATABASE_PROVIDER": "postgresql",
        "DATABASE_CONNECTION_URI": "${{Postgres.DATABASE_URL}}?schema=evolution",
        "DATABASE_CONNECTION_CLIENT_NAME": "evolution_exchange",
        "DATABASE_SAVE_DATA_INSTANCE": "true",
        "DATABASE_SAVE_DATA_NEW_MESSAGE": "true",
        "DATABASE_SAVE_MESSAGE_UPDATE": "true",
        "DATABASE_SAVE_DATA_CONTACTS": "true",
        "DATABASE_SAVE_DATA_CHATS": "true",
        "DATABASE_SAVE_DATA_LABELS": "true",
        "DATABASE_SAVE_DATA_HISTORIC": "true",
        "QRCODE_LIMIT": "30",
        "QRCODE_COLOR": "#175197",
        "CACHE_REDIS_ENABLED": "false",
        "CACHE_LOCAL_ENABLED": "true",
        "LANGUAGE": "pt-BR",
        "TYPEBOT_ENABLED": "false",
        "OPENAI_ENABLED": "false",
        "WEBHOOK_GLOBAL_ENABLED": "false",
        "LOG_LEVEL": "ERROR,WARN,INFO",
        "LOG_COLOR": "true",
        "LOG_BAILEYS": "error"
      }
    },
    {
      "name": "Agente",
      "icon": "🤖",
      "source": {
        "repo": "orodrigobarcelos/agente-ia-whatsapp-imersao-sac"
      },
      "variables": {
        "NODE_ENV": "production",
        "LOG_LEVEL": "info",
        "DATABASE_URL": "${{Postgres.DATABASE_URL}}",
        "EVOLUTION_URL": "http://${{Evolution.RAILWAY_PRIVATE_DOMAIN}}:8080",
        "EVOLUTION_API_KEY": "${{Evolution.AUTHENTICATION_API_KEY}}",
        "EVOLUTION_INSTANCE": "agente",
        "PUBLIC_URL": "https://${{RAILWAY_PUBLIC_DOMAIN}}",
        "OPENAI_API_KEY": {
          "default": "",
          "description": "Cole aqui sua key da OpenAI (sk-...). Mínimo $5 de crédito na conta."
        },
        "AGENT_PROMPT_BOOTSTRAP": {
          "default": "",
          "description": "(Opcional) Prompt inicial do agente. Deixe vazio se for configurar depois via Claude Code + MCP Postgres."
        }
      }
    }
  ]
}
