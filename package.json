{
  "name": "template-agente-ia-whatsapp-simplificado",
  "version": "0.1.0",
  "private": true,
  "description": "Template plug-and-play de agente IA pra WhatsApp via Evolution API + OpenAI + Postgres. Deploy 1 clique na Railway, customização via Claude Code + MCP Postgres.",
  "type": "module",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "migrate": "node dist/db/migrate.js",
    "boot": "node dist/db/migrate.js && node dist/server.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/sensible": "^6.0.1",
    "fastify": "^5.0.0",
    "openai": "^4.80.0",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "pino-pretty": "^11.2.2",
    "playwright": "^1.49.0",
    "playwright-extra": "^4.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
